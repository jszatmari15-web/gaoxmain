<!DOCTYPE html>
<html lang="hu">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Világtérkép 59×80 cm - Termékoldal</title>
    <link rel="icon" type="image/png" href="https://raw.githubusercontent.com/jszatmari15-web/gaoxmain/main/output-smallpngtools%20%281%29.png">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        brand: {
                            DEFAULT: '#4DA825',
                            hover: '#3e881e',
                            light: '#f0f9eb',
                            dark: '#111111'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #f8fafc;
            color: #111111;
        }
        .brand-wordmark {
            letter-spacing: 0.08em;
            text-transform: uppercase;
            line-height: 1;
        }
        ::-webkit-scrollbar {
            width: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f1f1;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between antialiased">

    <!-- Header -->
    <header class="bg-black text-white sticky top-0 z-40 shadow-md">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
            <div class="flex items-center min-w-0">
                <div class="brand-mark rounded-full p-1.5 flex items-center justify-center shrink-0">
                    <img src="https://raw.githubusercontent.com/jszatmari15-web/gaoxmain/main/output-smallpngtools%20%281%29.png" alt="GAOX logo" class="h-9 w-9">
                </div>
                <div class="ml-3 flex items-center">
                    <span class="brand-wordmark font-black text-lg sm:text-2xl text-white">GAOX</span>
                </div>
            </div>
            <div class="hidden md:flex flex-1 max-w-md mx-8">
                <div class="relative w-full">
                    <input type="text" placeholder="Keresés a termékek között..." class="w-full bg-neutral-900 border border-neutral-700 text-sm text-white placeholder-neutral-400 rounded-full py-2.5 pl-10 pr-4 focus:outline-none focus:ring-2 focus:ring-[#4DA825]/50">
                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-neutral-400 text-sm"></i>
                </div>
            </div>
        </div>
    </header>

    <!-- Morzsamenü -->
    <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 w-full">
        <ol class="flex items-center space-x-2 text-xs sm:text-sm text-gray-500">
            <li><a href="#" class="hover:text-black transition">Kezdőoldal</a></li>
            <li><i class="fa-solid fa-chevron-right text-[10px] text-gray-400"></i></li>
            <li><a href="#" class="hover:text-black transition">Otthon</a></li>
            <li><i class="fa-solid fa-chevron-right text-[10px] text-gray-400"></i></li>
            <li class="font-medium text-black truncate">Világtérkép 59×80 cm</li>
        </ol>
    </nav>

    <!-- Fő Termék Szekció -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-2 flex-grow w-full">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-4 sm:p-6 lg:p-8">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12">
                
                <!-- BAL OLDAL: Képek -->
                <div class="lg:col-span-5 flex flex-col space-y-4">
                    <div class="relative bg-neutral-50 rounded-xl border border-gray-200 overflow-hidden group aspect-square flex items-center justify-center">
                        <div class="absolute top-3 left-3 z-10">
                            <span class="bg-black text-white text-xs font-semibold px-2.5 py-1 rounded-md shadow-sm">Raktáron</span>
                        </div>
                        <img id="mainProductImage" src="https://images.unsplash.com/photo-1526778548025-fa2f459cd5c1?auto=format&fit=crop&w=800&q=80" alt="Világtérkép 59x80 cm" class="w-full h-full object-cover transition duration-300 group-hover:scale-105">
                    </div>
                </div>

                <!-- JOBB OLDAL: Infók -->
                <div class="lg:col-span-7 flex flex-col justify-between space-y-6">
                    <div>
                        <div class="flex justify-between items-start">
                            <div>
                                <h1 class="text-2xl sm:text-3xl font-bold text-black tracking-tight">Világtérkép 59×80 cm</h1>
                                <p class="text-xs text-gray-500 mt-1">Feltöltve: egy héttel ezelőtt</p>
                            </div>
                            <button class="text-gray-400 hover:text-red-500 transition p-2 rounded-full hover:bg-gray-50">
                                <i class="fa-regular fa-heart text-xl"></i>
                            </button>
                        </div>

                        <div class="mt-4 pb-4 border-b border-gray-100 flex items-baseline justify-between">
                            <div class="flex flex-col">
                                <span class="text-xs text-gray-400 line-through">4 000 Ft</span>
                                <span class="text-3xl sm:text-4xl font-extrabold text-[#4DA825]">4 480 Ft</span>
                                <span class="text-xs text-teal-700 mt-1"><i class="fa-regular fa-shield-check"></i> a következővel: (ár a vevő számára)</span>
                            </div>
                            <div class="flex items-center text-xs font-semibold text-[#4DA825] bg-[#f0f9eb] px-3 py-1.5 rounded-full">
                                <span class="w-2 h-2 rounded-full bg-[#4DA825] mr-2 animate-pulse"></span> Új, címkék nélkül
                            </div>
                        </div>

                        <p class="mt-4 text-gray-600 text-sm leading-relaxed">
                            Eladó egy stílusos lekaparható világtérkép fehér feliratokkal! Tökéletes ajándék utazók, kalandorok számára. A térkép segítségével könnyen nyomon követhetőek az utazásaink. Az egyszerű doboz könnyen dekorálható.
                        </p>

                        <div class="mt-6 grid grid-cols-3 gap-3">
                            <div class="bg-neutral-50 p-3 rounded-lg border border-neutral-100">
                                <span class="block text-xs text-gray-500 uppercase font-semibold">Állapot</span>
                                <span class="text-sm font-medium text-black">Új, címkék nélkül</span>
                            </div>
                            <div class="bg-neutral-50 p-3 rounded-lg border border-neutral-100">
                                <span class="block text-xs text-gray-500 uppercase font-semibold">Anyag</span>
                                <span class="text-sm font-medium text-black">Papír</span>
                            </div>
                            <div class="bg-neutral-50 p-3 rounded-lg border border-neutral-100">
                                <span class="block text-xs text-gray-500 uppercase font-semibold">Szín</span>
                                <span class="text-sm font-medium text-black">Barna</span>
                            </div>
                        </div>

                        <div class="mt-4 p-3 bg-neutral-950 text-white rounded-lg flex items-center justify-between text-xs sm:text-sm">
                            <div class="flex items-center space-x-2">
                                <i class="fa-solid fa-ruler text-[#4DA825]"></i>
                                <span><strong>Méret:</strong> 59 × 80 cm</span>
                            </div>
                        </div>
                    </div>

                    <!-- Szállítási információ -->
                    <div class="pt-4 border-t border-gray-100 flex justify-between text-xs text-gray-500">
                        <span>Szállítás</span>
                        <span class="font-semibold text-black">ettől: 799 Ft</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- RÉSZLETES ADATOK TÁBLÁZAT (Az Előresorolás helyett) -->
        <div class="mt-8 bg-white rounded-2xl shadow-sm border border-gray-100 p-6 sm:p-8">
            <h2 class="text-lg sm:text-xl font-bold text-black border-b border-gray-100 pb-4 flex items-center gap-2">
                <i class="fa-solid fa-circle-info text-[#4DA825]"></i> Részletes Adatok
            </h2>
            
            <div class="mt-6 border border-gray-100 rounded-xl overflow-hidden">
                <div class="bg-neutral-50/70 px-4 py-2.5 font-semibold text-xs text-gray-400 uppercase tracking-wider">
                    TERMÉKINFORMÁCIÓK
                </div>
                <div class="divide-y divide-gray-100 text-sm">
                    <div class="grid grid-cols-3 p-4 hover:bg-neutral-50/50">
                        <span class="text-gray-500">Állapot</span>
                        <span class="col-span-2 font-medium text-black">Új, címkék nélkül</span>
                    </div>
                    <div class="grid grid-cols-3 p-4 hover:bg-neutral-50/50">
                        <span class="text-gray-500">Méret</span>
                        <span class="col-span-2 font-medium text-black">59 × 80 cm</span>
                    </div>
                    <div class="grid grid-cols-3 p-4 hover:bg-neutral-50/50">
                        <span class="text-gray-500">Anyag</span>
                        <span class="col-span-2 font-medium text-black">Papír</span>
                    </div>
                    <div class="grid grid-cols-3 p-4 hover:bg-neutral-50/50">
                        <span class="text-gray-500">Szín</span>
                        <span class="col-span-2 font-medium text-black">Barna</span>
                    </div>
                </div>
            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-black text-white mt-16 border-t border-neutral-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-5 flex justify-between items-center text-sm text-neutral-400">
            <div class="flex items-center space-x-3">
                <img src="https://raw.githubusercontent.com/jszatmari15-web/gaoxmain/main/output-smallpngtools%20%281%29.png" alt="GAOX logo" class="h-8 w-8">
                <span class="brand-wordmark font-black text-xl text-white">GAOX</span>
            </div>
            <span>&copy; 2026 Minden jog fenntartva.</span>
        </div>
    </footer>
</body>
</html>
